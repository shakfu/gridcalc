      "model": {
        "lang": "pulp",
        "text": "# The Beer Distribution Problem (PuLP's example, as SolverStudio ships it).\n# Data items are globals; `flow` and `TotalCost` are output items.\nfrom pulp import *\n\nprob = LpProblem(\"Beer Distribution\", LpMinimize)\nflow = LpVariable.dicts(\"Route\", (Warehouses, Bars), 0, None, LpInteger)\nprob += lpSum(costs[w, b] * flow[w][b] for w in Warehouses for b in Bars)\nfor w in Warehouses:\n    prob += lpSum(flow[w][b] for b in Bars) <= supply[w], f\"supply_{w}\"\nfor b in Bars:\n    prob += lpSum(flow[w][b] for w in Warehouses) >= demand[b], f\"demand_{b}\"\nprob.solve()\nTotalCost = prob.objective\nSolverResult = LpStatus[prob.status]\nprint(\"status:\", SolverResult, \" cost:\", value(prob.objective))\n"
      }
