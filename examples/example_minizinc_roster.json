   "model": {
    "lang": "minizinc",
    "text": "% A shift roster, solved by Gecode: who works which shift, at least cost.\n% solver: gecode\nenum Staff;                                   % names from the sheet\nenum Shifts;                                  % in sheet order, so Mon AM comes before Mon PM\narray[Staff, Shifts] of 0..1: available;      % 1 = can work it; blank = 0\narray[Shifts] of int: needed;\narray[Staff] of int: maxShifts;\narray[Staff] of int: wage;                    % per shift\n\narray[Staff, Shifts] of var 0..1: assign;     % an output item\nvar int: TotalCost :: output = sum(p in Staff, s in Shifts)(wage[p] * assign[p, s]);\n\nconstraint forall(p in Staff, s in Shifts)(assign[p, s] <= available[p, s]);\nconstraint forall(s in Shifts)(sum(p in Staff)(assign[p, s]) >= needed[s]);\nconstraint forall(p in Staff)(sum(s in Shifts)(assign[p, s]) <= maxShifts[p]);\n% No back-to-back shifts.\nconstraint forall(p in Staff, i in 1..card(Shifts) - 1)(\n  assign[p, to_enum(Shifts, i)] + assign[p, to_enum(Shifts, i + 1)] <= 1);\nsolve minimize TotalCost;\n",
    "backend": "minizinc"
   }
