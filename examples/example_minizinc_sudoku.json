   "model": {
    "lang": "minizinc",
    "text": "% Sudoku by constraint programming, solved by Gecode.\n% solver: gecode\ninclude \"alldifferent.mzn\";\nset of int: Rows;                      % 1..9, from the row labels\nset of int: Cols;                      % 1..9, from the column labels\narray[Rows, Cols] of 0..9: givens;     % a blank cell reads as 0 (missing=0)\narray[Rows, Cols] of var 1..9: solution;\n\nconstraint forall(r in Rows, c in Cols where givens[r, c] > 0)(solution[r, c] = givens[r, c]);\nconstraint forall(r in Rows)(alldifferent([solution[r, c] | c in Cols]));\nconstraint forall(c in Cols)(alldifferent([solution[r, c] | r in Rows]));\nconstraint forall(i, j in 0..2)(\n  alldifferent([solution[3 * i + r, 3 * j + c] | r, c in 1..3]));\nsolve satisfy;\n",
    "backend": "minizinc"
   }
